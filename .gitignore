# Python
__pycache__/
*.py[cod]
venv/

# 运行数据：用户库与密钥严禁提交；strategy_records.db（策略回测记录）各机器本地维护，不入库
users.db
data/users.db
data/strategy_records.db
data/strategy_records.db.bak*
data/strategy_records_backup_before_remove.db
data/secret_key
data/secret.key
data/auto_trader_state.json
data/auto_futures_state.json
data/composite_state.json
data/composite_tasks.json
data/crypto_composite_state.json
data/crypto_composite_tasks.json
data/spot_tasks.json
data/futures_tasks.json
data/x.html
data/logs/
data/*.db-journal
data/*.db-wal
data/*.db-shm
# 运行时状态快照（带时间戳，与 crypto_composite_state.json 同类产物）
data/crypto_composite_state_*.json
data/*_state_*.json

# 环境配置（代理等，按机器不同）
.env

# 回测结果产物（明细/缓存不入库；最优策略页展示依赖的 JSON 随仓库分发）
/results/
scripts/cache/
scripts/cache_1s/
scripts/results/*
!scripts/results/*_summary_2024_2026.json
!scripts/results/recommended_configs.json
!scripts/results/macd_vol_1_2x_summary.json
!scripts/results/tp_close_vs_intraday_summary.json
# 最优策略页直接加载的展示数据（必须随仓库分发，否则生产端缺表）
!scripts/results/macd_c3_lev_1h.json
!scripts/results/top30_2021_c3_intraday_1h.json
!scripts/results/macd_vol_monthly_pos_1h.json
!scripts/results/ndx_pool_summary_1h.json
!scripts/results/us93_longonly_summary_1h.json

# 临时回测/验证脚本与中间产物（一次性分析，不入库）
scripts/tmp_*.py
scripts/res_*.txt
scripts/err_*.txt
scripts/results_*.txt
_tmp_*.py
scripts/scripts/

# 运行时资金曲线快照（任务权益历史，本地维护）
data/*_equity_*.json

